## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Rider files
.idea/
*.sln.iml

# Visual Studio cache/options directory
.vs/

# Visual Studio Code cache/options directory
.vscode/

# Rider
.idea_modules/
*.iml
out/

# Compiled binaries
bin/
obj/
*.exe
*.dll
*.pdb
*.so
*.dylib

# NuGet packages
*.nupkg
*.snupkg
packages/
.nuget/

# Output files
*.rtf
sample.xhtml
output_*.rtf

# Local user-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# macOS
.DS_Store

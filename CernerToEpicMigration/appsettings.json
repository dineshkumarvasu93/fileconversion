// Stage 1 (XHTML -> RTF). Full notes: README.md "Configuration".
// Precedence: this file < MigrationConfig__* environment variables < command line.
{
  "MigrationConfig": {

    // Paths
    "InputBasePath": "D:\\Migration\\Input",             // root of the date-wise input folders
    "OutputRtfBasePath": "D:\\Migration\\Output\\rtf",   // converted RTF, date structure mirrored
    "ReportBasePath": "D:\\Migration\\Reports",          // CSV reports, checkpoint, run lock
    "LogBasePath": "D:\\Migration\\Reports\\Logs",       // Serilog files

    // Logging
    "LogRetainedFileCountLimit": 30,   // log files kept per sink, oldest deleted first
    "LogFileSizeLimitMb": 256,         // roll at this size as well as daily
    "EnableSeparateErrorLog": true,    // also write errors_{date}.log at Warning and above

    "Processing": {

      // Threading and batching
      "MaxDegreeOfParallelism": 0,   // concurrent conversions; 0 = processor count
      "BatchSize": 1000,             // files per batch; also the checkpoint interval

      // Retry
      "MaxRetryCount": 3,   // TOTAL attempts per file, not extra ones; only Transient errors retry
      "RetryDelayMs": 500,  // base delay, multiplied by the attempt number: 500, 1000, ...

      // Which files are picked up
      "FileSearchPattern": "*.xhtml",     // which files are conversion candidates
      "PreScanForEstimates": true,        // count everything up front so progress covers the run
      "QuarantineUnmatchedFiles": true,   // move files this pattern misses to the error folder

      // Conversion
      "ConversionTimeoutSeconds": 60,      // Telerik import/export timeout per document
      "ValidateXhtmlContent": true,        // reject payloads with no XHTML instead of empty RTF
      "OverwriteExistingRtf": true,        // false makes an existing output a failure instead
      "EncodeRtfOutputAsBase64": false,    // wrap the RTF in a Base64 envelope

      // What happens to the input file afterwards
      "ArchiveOnSuccess": true,   // move converted inputs to {dateFolder}\archive

      // Reports and diagnostics
      "MaxErrorLogFiles": 0,             // cap on per-file .error.log files; 0 = no cap
      "MaxReportRowsPerFile": 250000,    // rows per report/trace part; 0 = one unsplit file
      "EnableFileTrace": true            // one row per document; ~130 MB per million
    },

    "Dashboard": {
      "RefreshIntervalSeconds": 5,      // console repaint interval
      "EnableConsoleDashboard": true    // off for unattended or service runs
    }
  }
}

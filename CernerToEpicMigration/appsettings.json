{
  "MigrationConfig": {
    "InputBasePath": "D:\\Migration\\Input",
    "OutputRtfBasePath": "D:\\Migration\\Output\\rtf",
    "ReportBasePath": "D:\\Migration\\Reports",
    "LogBasePath": "D:\\Migration\\Reports\\Logs",

    "Processing": {
      "MaxDegreeOfParallelism": 0,
      "BatchSize": 1000,
      "MaxRetryCount": 3,
      "RetryDelayMs": 500,
      "FileSearchPattern": "*.xhtml",
      "ConversionTimeoutSeconds": 60,
      "ArchiveOnSuccess": true,
      "OverwriteExistingRtf": true,
      "EnableStage1": true
    },

    "Dashboard": {
      "RefreshIntervalSeconds": 5,
      "EnableConsoleDashboard": true
    }
  }
}
